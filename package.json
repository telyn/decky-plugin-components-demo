{
  "name": "decky-plugin-components-demo",
  "version": "0.0.1",
  "description": "A decky-loader plugin demoing the components exported by @decky/ui, with live examples and source",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:ui:serve": "vite --config tests/frontend/harness/vite.config.ts tests/frontend/harness",
    "postinstall": "node scripts/patch-decky-ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telyn/decky-plugin-components-demo.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "decky-ui",
    "components",
    "demo"
  ],
  "author": "Telyn Z. <175827+telyn@users.noreply.github.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/telyn/decky-plugin-components-demo/issues"
  },
  "homepage": "https://github.com/telyn/decky-plugin-components-demo#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
